{% liquid
  assign slide_count = section.blocks.size
  assign first_slide = section.blocks.first
  assign desktop_ratio = 1.92
  assign mobile_ratio = 0.6465517241

  if first_slide.settings.image != blank
    assign desktop_ratio = first_slide.settings.image.aspect_ratio
  endif

  if first_slide.settings.image_mobile != blank
    assign mobile_ratio = first_slide.settings.image_mobile.aspect_ratio
  elsif first_slide.settings.image != blank
    assign mobile_ratio = first_slide.settings.image.aspect_ratio
  endif
%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<section
  id="PebbleSlider-{{ section.id }}"
  class="
    pebble-slider
    pebble-slider--container-{{ section.settings.container }}
    pebble-slider--height-{{ section.settings.height }}
    pebble-slider--content-{{ section.settings.content_position }}
    pebble-slider--controls-{{ section.settings.control_alignment }}
    {% if section.settings.enable_header_overlay %}pebble-slider--header-overlay{% endif %}
    {% if section.settings.next_section_overlap %}pebble-slider--next-overlap{% endif %}
    {% if section.settings.enable_animations %}pebble-slider--animations{% endif %}
  "
  data-pebble-slider
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-delay="{{ section.settings.change_slides_every | times: 1000 }}"
  data-control-type="{{ section.settings.control_type }}"
  data-previous-message="{{ 'sections.slideshow.previous_slide' | t | escape }}"
  data-next-message="{{ 'sections.slideshow.next_slide' | t | escape }}"
  style="
    --pebble-desktop-ratio: {{ desktop_ratio }};
    --pebble-mobile-ratio: {{ mobile_ratio }};
    --pebble-padding-top: {{ section.settings.padding_top }}px;
  "
>
  <div class="pebble-slider__frame">
    <div class="pebble-slider__swiper swiper" aria-roledescription="carousel">
      <div class="swiper-wrapper">
        {% content_for 'blocks' %}
      </div>

      {% if slide_count > 1 %}
        <div class="pebble-slider__controls" aria-label="{{ 'sections.slideshow.controls' | t }}">
          <div class="pebble-slider__status" aria-live="polite">
            <span data-current-slide>1</span>
            <span class="pebble-slider__status-separator" data-default-separator>/</span>
            <span class="pebble-slider__status-separator" data-progress-separator>{{ 'sections.slideshow.of' | t }}</span>
            <span data-total-slides>{{ slide_count }}</span>
          </div>

          <div class="pebble-slider__progress" aria-hidden="true">
            <span data-progress-bar></span>
          </div>

          <div class="pebble-slider__buttons">
            <button
              class="pebble-slider__arrow pebble-slider__arrow--previous"
              type="button"
              aria-label="{{ 'sections.slideshow.previous_slide' | t }}"
              data-previous
            >
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M12.5 3.75 6.25 10l6.25 6.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
              </svg>
            </button>
            <button
              class="pebble-slider__arrow pebble-slider__arrow--next"
              type="button"
              aria-label="{{ 'sections.slideshow.next_slide' | t }}"
              data-next
            >
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M7.5 3.75 13.75 10 7.5 16.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
              </svg>
            </button>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  @font-face {
    font-display: swap;
    font-family: 'Bricolage Grotesque';
    font-style: normal;
    font-weight: 500;
    src: url('{{ 'pebble-bricolage-500.woff2' | asset_url }}') format('woff2');
  }

  @font-face {
    font-display: swap;
    font-family: 'Bricolage Grotesque';
    font-style: normal;
    font-weight: 700;
    src: url('{{ 'pebble-bricolage-700.woff2' | asset_url }}') format('woff2');
  }

  #shopify-section-{{ section.id }}:has(.pebble-slider--next-overlap) {
    position: sticky;
    top: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }}:has(.pebble-slider--next-overlap) + .shopify-section {
    border-radius: 1.25rem 1.25rem 0 0;
    margin-top: clamp(-3.4rem, calc(-6.226vw + 2.975rem), -1.8rem);
    overflow: hidden;
    position: relative;
    z-index: 3;
  }

  #shopify-section-{{ section.id }}:has(.pebble-slider--next-overlap) + .section-scrolling-cards > .pebble-scrolling-cards {
    border-radius: 1.25rem 1.25rem 0 0;
  }

  @media screen and (min-width: 1200px) {
    body:has(#MainContent > #shopify-section-{{ section.id }}:first-child .pebble-slider--header-overlay) .site-header {
      background: transparent;
      border: 0;
      border-radius: 0;
      box-sizing: border-box;
      color: #111111;
      left: 0;
      min-height: 5rem;
      padding-inline: max(1rem, calc((100% - 90rem) / 2));
      position: absolute;
      right: 0;
      top: 1.875rem;
      transition:
        padding-left 520ms cubic-bezier(0.22, 1, 0.36, 1),
        padding-right 520ms cubic-bezier(0.22, 1, 0.36, 1);
      width: 100%;
      will-change: padding-left, padding-right;
      z-index: 20;
    }

    body:has(#MainContent > #shopify-section-{{ section.id }}:first-child .pebble-slider--header-overlay) .site-header__inner {
      margin: 0;
      max-width: none;
      min-height: 5rem;
      padding-inline: 1.875rem;
      width: 100%;
    }

    body:has(#MainContent > #shopify-section-{{ section.id }}:first-child .pebble-slider--header-overlay) .site-header.site-header--sticky.site-header--overlay.is-scrolled {
      background: transparent;
      left: 0;
      padding-inline: 0;
      position: fixed;
      right: 0;
      top: 0;
      width: 100%;
    }

    body:has(#MainContent > #shopify-section-{{ section.id }}:first-child .pebble-slider--header-overlay) .site-header.site-header--sticky.site-header--overlay.is-scrolled .site-header__inner {
      margin-inline: auto;
      min-height: 5rem;
      padding-inline: clamp(1rem, 2.5vw, 1.875rem);
      width: 100%;
    }
  }

  #PebbleSlider-{{ section.id }} {
    {{ section.settings.custom_css }}
  }
{% endstyle %}

{% stylesheet %}
  .pebble-slider {
    --pebble-content-width: 90rem;
    --pebble-page-padding: 1rem;
    color: #ffffff;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.6;
    overflow: clip;
    padding-top: var(--pebble-padding-top);
    position: relative;
  }

  .pebble-slider *,
  .pebble-slider *::before,
  .pebble-slider *::after {
    box-sizing: border-box;
  }

  .pebble-slider__frame {
    height: 45rem;
    margin-inline: auto;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .pebble-slider--container-fixed .pebble-slider__frame {
    border-radius: 0.5rem;
    max-width: 90rem;
    width: calc(100% - 2rem);
  }

  .pebble-slider--height-adapt .pebble-slider__frame {
    aspect-ratio: var(--pebble-desktop-ratio);
    height: auto;
    max-height: 100svh;
  }

  .pebble-slider--height-small .pebble-slider__frame {
    height: 35.625rem;
  }

  .pebble-slider--height-medium .pebble-slider__frame {
    height: 41.25rem;
  }

  .pebble-slider--height-large .pebble-slider__frame {
    height: 46.875rem;
  }

  .pebble-slider__swiper,
  .pebble-slider__swiper .swiper-wrapper,
  .pebble-slider__slide {
    height: 100%;
  }

  .pebble-slider__slide {
    background: var(--slide-background, #a8b692);
    color: var(--slide-text, #ffffff);
    isolation: isolate;
    overflow: hidden;
    position: relative;
  }

  .pebble-slider__media,
  .pebble-slider__image,
  .pebble-slider__video,
  .pebble-slider__placeholder,
  .pebble-slider__overlay {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }

  .pebble-slider__image,
  .pebble-slider__video,
  .pebble-slider__placeholder {
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .pebble-slider__image--mobile {
    display: none;
  }

  .pebble-slider__placeholder {
    background: #bda18f;
    fill: #d7c8b7;
  }

  .pebble-slider__overlay {
    background: var(--slide-overlay-color, #000000);
    opacity: 0.1;
    pointer-events: none;
    z-index: 1;
  }

  .pebble-slider__content-position {
    bottom: 5.25rem;
    display: flex;
    left: 0;
    padding: 2.5rem var(--pebble-page-padding);
    pointer-events: none;
    position: absolute;
    right: 0;
    top: 0;
    z-index: 2;
  }

  .pebble-slider--header-overlay .pebble-slider__content-position {
    top: 6.875rem;
  }

  .pebble-slider__content-position--top-left {
    align-items: flex-start;
    justify-content: flex-start;
  }

  .pebble-slider__content-position--top-center {
    align-items: flex-start;
    justify-content: center;
  }

  .pebble-slider__content-position--top-right {
    align-items: flex-start;
    justify-content: flex-end;
  }

  .pebble-slider__content-position--middle-left {
    align-items: center;
    justify-content: flex-start;
  }

  .pebble-slider__content-position--middle-center {
    align-items: center;
    justify-content: center;
  }

  .pebble-slider__content-position--middle-right {
    align-items: center;
    justify-content: flex-end;
  }

  .pebble-slider__content-position--bottom-left {
    align-items: flex-end;
    justify-content: flex-start;
  }

  .pebble-slider__content-position--bottom-center {
    align-items: flex-end;
    justify-content: center;
  }

  .pebble-slider__content-position--bottom-right {
    align-items: flex-end;
    justify-content: flex-end;
  }

  .pebble-slide-content {
    align-items: flex-start;
    background: var(--content-background);
    border-radius: var(--content-radius);
    color: var(--content-text);
    display: flex;
    flex-direction: column;
    gap: var(--content-row-gap-fluid, var(--content-row-gap));
    max-width: min(100%, 44rem);
    padding: var(--content-padding-top) var(--content-padding-right) var(--content-padding-bottom) var(--content-padding-left);
    pointer-events: auto;
  }

  .pebble-slide-content--inherit {
    color: inherit;
  }

  .pebble-slide-content--transparent {
    background: transparent;
  }

  .pebble-slide-content--border-solid {
    border: 1px solid currentColor;
  }

  .pebble-slide-content--width-fit {
    width: fit-content;
  }

  .pebble-slide-content--width-fill {
    width: 100%;
  }

  .pebble-slide-content--width-custom {
    width: var(--content-custom-width);
  }

  .pebble-slide-content--align-left {
    align-items: flex-start;
    text-align: left;
  }

  .pebble-slide-content--align-center {
    align-items: center;
    text-align: center;
  }

  .pebble-slide-content--align-right {
    align-items: flex-end;
    text-align: right;
  }

  .pebble-content-block {
    flex: 0 0 auto;
    margin: 0;
    max-width: 100%;
  }

  .pebble-content-block p {
    margin: 0;
  }

  .pebble-text {
    max-width: var(--text-max-width);
    padding:
      var(--text-padding-top-fluid, var(--text-padding-top))
      var(--text-padding-right-fluid, var(--text-padding-right))
      var(--text-padding-bottom-fluid, var(--text-padding-bottom))
      var(--text-padding-left-fluid, var(--text-padding-left));
  }

  .pebble-text--preset-default,
  .pebble-text--preset-paragraph {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5rem;
  }

  .pebble-text--preset-subheading {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.5rem;
    text-transform: uppercase;
  }

  .pebble-text--preset-heading-1 {
    font-size: 4.25rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pebble-text--preset-heading-2 {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pebble-text--preset-heading-3 {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pebble-text--preset-heading-4 {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pebble-text--preset-heading-5 {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pebble-text--preset-heading-6 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pebble-text--preset-custom {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: var(--text-size-fluid, var(--text-size));
    font-weight: var(--text-weight);
    line-height: var(--text-line-height);
  }

  .pebble-text--width-fit {
    width: fit-content;
  }

  .pebble-text--width-fill {
    width: 100%;
  }

  .pebble-text--color-subtext {
    opacity: 0.75;
  }

  .pebble-text--color-gradient {
    background: linear-gradient(90deg, currentColor, rgb(255 255 255 / 55%));
    background-clip: text;
    color: transparent;
  }

  .pebble-text--highlight-standard em {
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.12em;
  }

  .pebble-text--highlight-wavy-underline em {
    text-decoration: underline wavy;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
  }

  .pebble-text--highlight-solid-background em {
    background: currentColor;
    border-radius: 0.2em;
    color: var(--slide-background, #111111);
    padding-inline: 0.12em;
  }

  .pebble-heading {
    color: inherit;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: var(--heading-size-fluid, var(--heading-size));
    font-weight: var(--heading-weight);
    letter-spacing: var(--heading-letter-spacing);
    line-height: var(--heading-line-height);
    max-width: var(--heading-max-width);
  }

  .pebble-subheading {
    font-size: var(--subheading-size-fluid, var(--subheading-size));
    line-height: 1.35;
    max-width: var(--subheading-max-width);
  }

  .pebble-button {
    --pebble-button-end-padding: 0.625rem;
    --pebble-icon-radius: 0.9375rem;
    align-items: center;
    border: 1px solid transparent;
    border-radius: 3.75rem;
    display: inline-flex;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    gap: 0.5rem;
    justify-content: center;
    line-height: 1.5rem;
    overflow: hidden;
    position: relative;
    text-decoration: none;
    text-transform: capitalize;
    transition: background-color 350ms, color 350ms, border-color 350ms, opacity 350ms, transform 350ms;
    white-space: nowrap;
    z-index: 0;
  }

  .pebble-button--size-extra-small {
    height: 1.875rem;
    padding: 0.1875rem 2.25rem 0.1875rem 0.875rem;
  }

  .pebble-button--size-small {
    height: 2.375rem;
    padding: 0.4375rem 2.5rem 0.4375rem 1.125rem;
  }

  .pebble-button--size-medium {
    height: 2.75rem;
    padding: 0.625rem 2.75rem 0.625rem 1.25rem;
  }

  .pebble-button--size-large {
    height: 3.125rem;
    padding: 0.625rem 3rem 0.625rem 1.5rem;
  }

  .pebble-button--primary {
    background: var(--slide-button, #ffffff);
    color: var(--slide-button-label, #111111);
  }

  .pebble-button--secondary {
    background: transparent;
    border-color: currentColor;
    color: inherit;
  }

  .pebble-button--outline {
    background: transparent;
    border-color: currentColor;
    color: inherit;
  }

  .pebble-button--plain {
    background: transparent;
    border-color: transparent;
    color: inherit;
    padding-inline: 0;
  }

  .pebble-button--icon-default {
    padding-inline-end: 1.5rem;
  }

  .pebble-button--icon-only {
    aspect-ratio: 1;
    justify-content: center;
    padding: 0;
  }

  .pebble-button--icon-only .pebble-button__hover {
    justify-content: center;
    padding: 0;
  }

  .pebble-button__text,
  .pebble-button__hover-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pebble-button__hover {
    align-items: center;
    background: var(--slide-button-label, #111111);
    clip-path: circle(var(--pebble-icon-radius) at calc(100% - var(--pebble-icon-radius) - var(--pebble-button-end-padding)) 50%);
    color: var(--slide-button, #ffffff);
    display: flex;
    gap: 0.5rem;
    height: 100%;
    inset: 0 auto 0 0;
    justify-content: space-between;
    overflow: hidden;
    padding-inline: 1.5rem var(--pebble-button-end-padding);
    position: absolute;
    transition: clip-path 600ms cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
    z-index: 2;
  }

  .pebble-button__icon {
    align-items: center;
    border-radius: 50%;
    display: flex;
    flex: 0 0 auto;
    height: calc(var(--pebble-icon-radius) * 2);
    justify-content: center;
    overflow: hidden;
    width: calc(var(--pebble-icon-radius) * 2);
  }

  .pebble-button__icon svg {
    height: 1.25rem;
    width: 1.25rem;
  }

  .pebble-button--icon-default .pebble-button__icon {
    height: 1.25rem;
    width: 1.25rem;
  }

  .pebble-spacer {
    height: var(--spacer-height-fluid, var(--spacer-height));
    width: 100%;
  }

  .pebble-slider--content-outside .pebble-slider__slide {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .pebble-slider--content-outside .pebble-slider__media {
    grid-row: 1;
    position: relative;
  }

  .pebble-slider--content-outside .pebble-slider__overlay {
    bottom: auto;
    height: calc(100% - 10rem);
  }

  .pebble-slider--content-outside .pebble-slider__content-position {
    background: var(--slide-background);
    bottom: auto;
    grid-row: 2;
    min-height: 10rem;
    padding-block: 2rem;
    position: relative;
    top: auto;
  }

  .pebble-slider__controls {
    align-items: center;
    bottom: 3.75rem;
    color: #ffffff;
    display: flex;
    gap: 0.75rem;
    left: var(--pebble-page-padding);
    position: absolute;
    right: var(--pebble-page-padding);
    z-index: 5;
  }

  .pebble-slider--controls-left .pebble-slider__controls {
    justify-content: flex-start;
  }

  .pebble-slider--controls-center .pebble-slider__controls {
    justify-content: center;
  }

  .pebble-slider--controls-right .pebble-slider__controls {
    justify-content: flex-end;
  }

  .pebble-slider__status {
    display: flex;
    flex: 0 0 auto;
    font-size: 0.9375rem;
    font-weight: 500;
    gap: 0.25rem;
    line-height: 1.5rem;
    white-space: nowrap;
  }

  .pebble-slider__progress {
    background: rgb(255 255 255 / 10%);
    height: 2px;
    overflow: hidden;
    position: relative;
    width: 8.75rem;
  }

  .pebble-slider__progress span {
    background: currentColor;
    display: block;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    width: 100%;
  }

  .pebble-slider__buttons {
    display: flex;
    flex: 0 0 auto;
    gap: 0.5rem;
  }

  .pebble-slider__arrow {
    align-items: center;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: flex;
    height: 1rem;
    justify-content: center;
    padding: 0;
    width: 1rem;
  }

  .pebble-slider__arrow svg {
    height: 1rem;
    width: 1rem;
  }

  .pebble-slider[data-control-type='default'] [data-progress-separator],
  .pebble-slider[data-control-type='progress-text'] [data-default-separator] {
    display: none;
  }

  @media screen and (min-width: 1200px) {
    .pebble-slider {
      --pebble-page-padding: 3.125rem;
    }
  }

  @media screen and (min-width: 1536px) {
    .pebble-slider {
      --pebble-page-padding: max(8.4375rem, calc((100% - var(--pebble-content-width)) / 2));
    }
  }

  .pebble-slider--animations .swiper-slide-active .pebble-slider__media {
    animation: pebble-media-enter 1.3s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .pebble-slider--animations .swiper-slide-active [data-motion='fade-in'] {
    animation: pebble-fade-in 1.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--motion-delay, 0ms);
  }

  .pebble-slider--animations .swiper-slide-active [data-motion='fade-up'] {
    animation: pebble-fade-up 1.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--motion-delay, 0ms);
  }

  .pebble-slider--animations .swiper-slide-active [data-motion='slide-left'] {
    animation: pebble-slide-left 1.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--motion-delay, 0ms);
  }

  .pebble-slider--animations .swiper-slide-active [data-motion='slide-right'] {
    animation: pebble-slide-right 1.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--motion-delay, 0ms);
  }

  @keyframes pebble-media-enter {
    from { transform: scale(1.15); }
    to { transform: scale(1); }
  }

  @keyframes pebble-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes pebble-fade-up {
    from { opacity: 0; transform: translateY(2.5rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes pebble-slide-left {
    from { opacity: 0; transform: translateX(2.5rem); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes pebble-slide-right {
    from { opacity: 0; transform: translateX(-2.5rem); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes pebble-arrow-loop {
    0% { transform: translateX(0); }
    50% { transform: translateX(1.25rem); }
    50.001% { transform: translateX(-1.25rem); }
    100% { transform: translateX(0); }
  }

  @media (hover: hover) and (pointer: fine) {
    .pebble-button:hover .pebble-button__hover {
      clip-path: circle(150% at calc(100% - var(--pebble-icon-radius) - var(--pebble-button-end-padding)) 50%);
    }

    .pebble-button:hover .pebble-button__icon svg {
      animation: pebble-arrow-loop 1s ease infinite;
    }

    .pebble-slider__arrow {
      transition: opacity 200ms, transform 200ms;
    }

    .pebble-slider__arrow:hover {
      opacity: 0.65;
      transform: scale(1.12);
    }
  }

  @media screen and (min-width: 768px) and (max-width: 1199.98px) {
    .pebble-slider {
      --pebble-page-padding: clamp(1rem, 3.125vw, 3.125rem);
    }

    .pebble-slider--header-overlay .pebble-slider__content-position {
      bottom: clamp(2rem, calc(8vw - 2.5rem), 3.75rem);
      padding-block: clamp(1.25rem, 3vw, 2.5rem);
      top: 0;
    }

    .pebble-slider--header-overlay .pebble-slider__content-position--middle-left,
    .pebble-slider--header-overlay .pebble-slider__content-position--middle-center,
    .pebble-slider--header-overlay .pebble-slider__content-position--middle-right {
      align-items: flex-start;
    }

    .pebble-slider__controls {
      bottom: clamp(2rem, calc(8vw - 2.5rem), 3.75rem);
      gap: clamp(0.5rem, 1.2vw, 0.75rem);
    }
  }

  @media screen and (max-width: 767.98px) {
    .pebble-slider {
      --pebble-page-padding: 1rem;
    }

    .pebble-slider--container-fixed .pebble-slider__frame {
      border-radius: 0;
      width: 100%;
    }

    .pebble-slider--height-adapt .pebble-slider__frame {
      aspect-ratio: var(--pebble-mobile-ratio);
      max-height: none;
    }

    .pebble-slider--height-small .pebble-slider__frame,
    .pebble-slider--height-medium .pebble-slider__frame,
    .pebble-slider--height-large .pebble-slider__frame {
      height: 36.25rem;
    }

    .pebble-slider__media--has-mobile .pebble-slider__image--desktop {
      display: none;
    }

    .pebble-slider__media--has-mobile .pebble-slider__image--mobile {
      display: block;
    }

    .pebble-slider__content-position,
    .pebble-slider--header-overlay .pebble-slider__content-position {
      bottom: 4rem;
      padding: 1.5rem 1rem;
      top: 0;
    }

    .pebble-slider__content-position--mobile-top {
      align-items: flex-start;
    }

    .pebble-slider__content-position--mobile-middle {
      align-items: center;
    }

    .pebble-slider__content-position--mobile-bottom {
      align-items: flex-end;
    }

    .pebble-slide-content {
      max-width: 100%;
    }

    .pebble-slide-content:has(.pebble-button--full-mobile) {
      width: 100%;
    }

    .pebble-slide-content--mobile-align-left {
      align-items: flex-start;
      text-align: left;
    }

    .pebble-slide-content--mobile-align-center {
      align-items: center;
      text-align: center;
    }

    .pebble-slide-content--mobile-align-right {
      align-items: flex-end;
      text-align: right;
    }


    .pebble-text--mobile-width-fit {
      width: fit-content;
    }

    .pebble-text--mobile-width-fill {
      width: 100%;
    }

    .pebble-text--single-line-mobile br {
      display: none;
    }


    .pebble-button--full-mobile {
      justify-content: flex-start;
      width: 100%;
    }


    .pebble-slider__controls {
      bottom: 2.5rem;
      left: 1rem;
      right: 1rem;
    }

    .pebble-slider__progress {
      flex: 1 1 auto;
      width: auto;
    }

    .pebble-slider--content-outside .pebble-slider__content-position {
      bottom: auto;
      top: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pebble-slider--animations .swiper-slide-active .pebble-slider__media,
    .pebble-slider--animations .swiper-slide-active [data-motion],
    .pebble-button__hover,
    .pebble-button__icon svg {
      animation: none;
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function loadSwiper() {
      if (window.Swiper) return Promise.resolve();
      if (window.PebbleSwiperPromise) return window.PebbleSwiperPromise;

      window.PebbleSwiperPromise = new Promise(function (resolve, reject) {
        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.async = true;
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });

      return window.PebbleSwiperPromise;
    }

    function initializeSlider(root) {
      if (!root || root.dataset.initialized === 'true') return;

      var container = root.querySelector('.pebble-slider__swiper');
      if (!container) return;

      var slides = container.querySelectorAll('.swiper-wrapper > [data-slide-block]');
      if (slides.length < 2) {
        root.dataset.initialized = 'true';
        return;
      }

      var autoplayEnabled = root.dataset.autoplay === 'true';
      var autoplayDelay = Number(root.dataset.delay);
      var previousButton = root.querySelector('[data-previous]');
      var nextButton = root.querySelector('[data-next]');
      var currentSlide = root.querySelector('[data-current-slide]');
      var totalSlides = root.querySelector('[data-total-slides]');
      var progressBar = root.querySelector('[data-progress-bar]');

      root.dataset.initialized = 'true';

      function updateStatus(swiper) {
        if (currentSlide) currentSlide.textContent = String(swiper.realIndex + 1);
        if (totalSlides) totalSlides.textContent = String(slides.length);
      }

      function restartProgress() {
        if (!progressBar) return;

        progressBar.style.transition = 'none';
        progressBar.style.transform = 'scaleX(0)';
        progressBar.offsetWidth;

        if (!autoplayEnabled) {
          progressBar.style.transform = 'scaleX(1)';
          return;
        }

        requestAnimationFrame(function () {
          progressBar.style.transition = 'transform ' + autoplayDelay + 'ms linear';
          progressBar.style.transform = 'scaleX(1)';
        });
      }

      root.pebbleSwiper = new Swiper(container, {
        a11y: {
          enabled: true,
          prevSlideMessage: root.dataset.previousMessage,
          nextSlideMessage: root.dataset.nextMessage
        },
        autoplay: autoplayEnabled
          ? {
              delay: autoplayDelay,
              disableOnInteraction: false
            }
          : false,
        effect: 'fade',
        fadeEffect: {
          crossFade: true
        },
        loop: true,
        navigation: {
          nextEl: nextButton,
          prevEl: previousButton
        },
        speed: 300,
        watchOverflow: true,
        on: {
          afterInit: function (swiper) {
            updateStatus(swiper);
            restartProgress();
          },
          realIndexChange: function (swiper) {
            updateStatus(swiper);
            restartProgress();
          },
          autoplayResume: restartProgress
        }
      });
    }

    function initializeAll(scope) {
      var roots = (scope || document).querySelectorAll('[data-pebble-slider]');

      roots.forEach(function (root) {
        loadSwiper().then(function () {
          initializeSlider(root);
        });
      });
    }

    initializeAll();

    document.addEventListener('shopify:section:load', function (event) {
      initializeAll(event.target);
    });

    document.addEventListener('shopify:section:unload', function (event) {
      var root = event.target.querySelector('[data-pebble-slider]');
      if (root && root.pebbleSwiper) root.pebbleSwiper.destroy(true, true);
    });

    document.addEventListener('shopify:block:select', function (event) {
      var slide = event.target.closest('[data-slide-block]');
      var root = event.target.closest('[data-pebble-slider]');
      if (!slide || !root || !root.pebbleSwiper) return;

      var slides = Array.prototype.slice.call(root.querySelectorAll('.swiper-wrapper > [data-slide-block]:not(.swiper-slide-duplicate)'));
      var index = slides.indexOf(slide);

      if (index > -1) root.pebbleSwiper.slideToLoop(index);
      if (root.pebbleSwiper.autoplay) root.pebbleSwiper.autoplay.stop();
    });

    document.addEventListener('shopify:block:deselect', function (event) {
      var root = event.target.closest('[data-pebble-slider]');
      if (root && root.pebbleSwiper && root.pebbleSwiper.autoplay && root.dataset.autoplay === 'true') {
        root.pebbleSwiper.autoplay.start();
      }
    });
  })();
{% endjavascript %}

