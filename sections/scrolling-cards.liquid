{% liquid
  assign section_scheme = section.settings.color_scheme
%}

<section
  id="PebbleScrollingCards-{{ section.id }}"
  class="
    pebble-scrolling-cards
    pebble-scrolling-cards--border-{{ section.settings.border }}
    color-{{ section_scheme.id }}
  "
  data-pebble-scrolling-cards
  style="
    --scroll-background: {{ section_scheme.settings.background_gradient | default: section_scheme.settings.background }};
    --scroll-text: {{ section_scheme.settings.text }};
    --scroll-button: {{ section_scheme.settings.button }};
    --scroll-button-label: {{ section_scheme.settings.button_label }};
    --scroll-border: {{ section_scheme.settings.text | color_modify: 'alpha', 0.16 }};
    --scroll-radius: {{ section.settings.corner_radius }}px;
    --scroll-padding-top: {{ section.settings.padding_top }}px;
    --scroll-padding-bottom: {{ section.settings.padding_bottom }}px;
    --scroll-mobile-card-width: {{ section.settings.mobile_card_width }}vw;
    --slide-button: {{ section_scheme.settings.button }};
    --slide-button-label: {{ section_scheme.settings.button_label }};
  "
>
  <div class="pebble-scrolling-cards__page">
    {% content_for 'blocks' %}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }}.shopify-section.section-scrolling-cards {
    overflow: visible;
  }

  @font-face {
    font-display: swap;
    font-family: 'Bricolage Grotesque';
    font-style: normal;
    font-weight: 500;
    src: url('{{ 'pebble-bricolage-500.woff2' | asset_url }}') format('woff2');
  }

  @font-face {
    font-display: swap;
    font-family: 'Bricolage Grotesque';
    font-style: normal;
    font-weight: 700;
    src: url('{{ 'pebble-bricolage-700.woff2' | asset_url }}') format('woff2');
  }

  {% if section.settings.custom_css != blank %}
    #PebbleScrollingCards-{{ section.id }} {
      {{ section.settings.custom_css }}
    }
  {% endif %}
{% endstyle %}

{% stylesheet %}
  html.pebble-scrolling-cards-smoothing {
    scroll-behavior: auto !important;
  }

  .pebble-scrolling-cards {
    background: var(--scroll-background, #ffffff);
    border: 0 solid var(--scroll-border, rgba(17, 17, 17, 0.16));
    border-radius: var(--scroll-radius, 0);
    color: var(--scroll-text, #111111);
    padding-block:
      min(var(--scroll-padding-top, 100px), clamp(48px, calc(7.558vw - 9.97px), 100px))
      min(var(--scroll-padding-bottom, 100px), clamp(48px, calc(7.558vw - 9.97px), 100px));
    position: relative;
  }

  .pebble-scrolling-cards--border-solid {
    border-width: 1px;
  }

  .pebble-scrolling-cards__page {
    margin-inline: auto;
    position: relative;
    width: min(calc(100% - 100px), 1440px);
  }

  .pebble-scrolling-cards__cards {
    column-gap: 50px;
    display: grid;
    grid-auto-flow: row;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr);
    position: relative;
    row-gap: 80px;
  }

  .pebble-scrolling-cards__card-cell {
    align-items: flex-start;
    contain: layout;
    display: flex;
    min-width: 0;
  }

  .pebble-scrolling-cards__card-cell:nth-child(odd) {
    grid-column: 1;
  }

  .pebble-scrolling-cards__card-cell:nth-child(even) {
    align-items: flex-end;
    grid-column: 3;
    padding-top: 140px;
  }

  .pebble-scrolling-cards__content-shell {
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 2;
  }

  .pebble-scrolling-cards__content {
    align-items: center;
    column-gap: 50px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr);
    height: min(100%, calc(100dvh - var(--scroll-header-height, 80px)));
    position: sticky;
    top: 0;
    width: 100%;
  }

  .pebble-scrolling-cards__content-inner {
    align-items: center;
    display: flex;
    flex-direction: column;
    grid-column: 2;
    justify-content: center;
    max-width: none;
    padding-inline: 0;
    pointer-events: auto;
    text-align: center;
    width: 100%;
  }

  .pebble-scrolling-cards .pebble-content-block {
    flex: 0 0 auto;
    margin: 0;
    max-width: 100%;
  }

  .pebble-scrolling-cards .pebble-content-block p {
    margin: 0;
  }

  .pebble-scrolling-cards__content-inner > .pebble-subheading {
    color: inherit;
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-size: var(--subheading-size-fluid, var(--subheading-size, 0.875rem));
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: clamp(1.25rem, 2.2vw, 2rem);
    max-width: var(--subheading-max-width, 30ch);
    order: 1;
    text-transform: uppercase;
  }

  .pebble-scrolling-cards__heading-viewport {
    order: 2;
    overflow: clip;
    position: relative;
    width: 100%;
  }

  .pebble-scrolling-cards__heading-track {
    backface-visibility: hidden;
    transform: translate3d(0, var(--heading-offset, 0px), 0);
    will-change: transform;
  }

  .pebble-scrolling-heading {
    align-items: center;
    display: flex;
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-size: var(--scroll-heading-size, 3rem);
    font-weight: var(--scroll-heading-weight, 700);
    justify-content: center;
    line-height: var(--scroll-heading-line-height, 1.2);
    margin-inline: auto;
    max-width: var(--scroll-heading-max-width, 18ch);
    text-align: center;
    width: 100%;
  }

  .pebble-scrolling-heading p {
    margin: 0;
  }

  .pebble-scrolling-heading em {
    color: var(--scroll-heading-highlight-text, currentColor);
    font-style: var(--scroll-heading-highlight-style, normal);
  }

  .pebble-scrolling-heading--highlight-solid-background em {
    background:
      linear-gradient(
        to right,
        var(--scroll-heading-highlight),
        var(--scroll-heading-highlight)
      )
      no-repeat 0 50% / 100% 92%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding-inline: 0.04em;
  }

  .pebble-scrolling-heading--highlight-standard em {
    text-decoration-color: var(--scroll-heading-highlight);
    text-decoration-line: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.12em;
  }

  .pebble-scrolling-heading--highlight-wavy-underline em {
    text-decoration-color: var(--scroll-heading-highlight);
    text-decoration-line: underline;
    text-decoration-style: wavy;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
  }

  .pebble-scrolling-cards__content-inner > .pebble-text {
    color: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5rem;
    margin-top: clamp(1.25rem, 2.2vw, 2rem);
    max-width: var(--text-max-width, 42ch);
    order: 3;
    padding:
      var(--text-padding-top-fluid, var(--text-padding-top, 0))
      var(--text-padding-right-fluid, var(--text-padding-right, 0))
      var(--text-padding-bottom-fluid, var(--text-padding-bottom, 0))
      var(--text-padding-left-fluid, var(--text-padding-left, 0));
  }

  .pebble-scrolling-cards__content-inner > .pebble-text--color-subtext {
    opacity: 0.72;
  }

  .pebble-scrolling-cards__content-inner > .pebble-text--width-fill {
    width: 100%;
  }

  .pebble-scrolling-cards__content-inner > .pebble-text--width-fit {
    width: fit-content;
  }

  .pebble-scrolling-cards .pebble-button {
    --pebble-button-end-padding: 0.625rem;
    --pebble-icon-radius: 0.9375rem;
    align-items: center;
    border: 1px solid transparent;
    border-radius: 3.75rem;
    display: inline-flex;
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    gap: 0.5rem;
    justify-content: center;
    line-height: 1.5rem;
    margin-top: 2rem;
    order: 4;
    overflow: hidden;
    position: relative;
    text-decoration: none;
    text-transform: capitalize;
    transition: background-color 350ms, color 350ms, border-color 350ms, opacity 350ms, transform 350ms;
    white-space: nowrap;
    z-index: 0;
  }

  .pebble-scrolling-cards .pebble-button--size-extra-small {
    height: 1.875rem;
    padding: 0.1875rem 2.25rem 0.1875rem 0.875rem;
  }

  .pebble-scrolling-cards .pebble-button--size-small {
    height: 2.375rem;
    padding: 0.4375rem 2.5rem 0.4375rem 1.125rem;
  }

  .pebble-scrolling-cards .pebble-button--size-medium {
    height: 2.75rem;
    padding: 0.625rem 2.75rem 0.625rem 1.25rem;
  }

  .pebble-scrolling-cards .pebble-button--size-large {
    height: 3.125rem;
    padding: 0.625rem 3rem 0.625rem 1.5rem;
  }

  .pebble-scrolling-cards .pebble-button--primary {
    background: var(--scroll-button, #111111);
    color: var(--scroll-button-label, #ffffff);
  }

  .pebble-scrolling-cards .pebble-button--secondary,
  .pebble-scrolling-cards .pebble-button--outline {
    background: transparent;
    border-color: currentColor;
    color: inherit;
  }

  .pebble-scrolling-cards .pebble-button--plain {
    background: transparent;
    border-color: transparent;
    color: inherit;
    padding-inline: 0;
  }

  .pebble-scrolling-cards .pebble-button--icon-default {
    padding-inline-end: 1.5rem;
  }

  .pebble-scrolling-cards .pebble-button--icon-only {
    aspect-ratio: 1;
    justify-content: center;
    padding: 0;
  }

  .pebble-scrolling-cards .pebble-button__text,
  .pebble-scrolling-cards .pebble-button__hover-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pebble-scrolling-cards .pebble-button__hover {
    align-items: center;
    background: var(--scroll-button-label, #ffffff);
    clip-path: circle(var(--pebble-icon-radius) at calc(100% - var(--pebble-icon-radius) - var(--pebble-button-end-padding)) 50%);
    color: var(--scroll-button, #111111);
    display: flex;
    gap: 0.5rem;
    height: 100%;
    inset: 0 auto 0 0;
    justify-content: space-between;
    overflow: hidden;
    padding-inline: 1.5rem var(--pebble-button-end-padding);
    position: absolute;
    transition: clip-path 600ms cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
    z-index: 2;
  }

  .pebble-scrolling-cards .pebble-button__icon {
    align-items: center;
    border-radius: 50%;
    display: flex;
    flex: 0 0 auto;
    height: calc(var(--pebble-icon-radius) * 2);
    justify-content: center;
    overflow: hidden;
    width: calc(var(--pebble-icon-radius) * 2);
  }

  .pebble-scrolling-cards .pebble-button__icon svg {
    height: 1.25rem;
    width: 1.25rem;
  }

  .pebble-scrolling-cards .pebble-button--icon-default .pebble-button__icon {
    height: 1.25rem;
    width: 1.25rem;
  }

  .pebble-product-overlay-card {
    aspect-ratio: var(--card-ratio, 3 / 4);
    background: linear-gradient(145deg, #bfe5ff 0%, #f4d5da 100%);
    border-radius: var(--card-radius, 1.25rem);
    color: var(--card-text, #ffffff);
    container-type: inline-size;
    min-width: 0;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .pebble-scrolling-cards__card-cell:nth-child(3n + 2) .pebble-product-overlay-card {
    background: linear-gradient(145deg, #f4d1c1 0%, #9dbde9 100%);
  }

  .pebble-scrolling-cards__card-cell:nth-child(3n) .pebble-product-overlay-card {
    background: linear-gradient(145deg, #d9cdf7 0%, #f7d5d8 100%);
  }

  .pebble-product-overlay-card__media {
    color: inherit;
    inset: 0;
    position: absolute;
    text-decoration: none;
  }

  .pebble-product-overlay-card__media picture {
    display: contents;
  }

  .pebble-product-overlay-card__banner,
  .pebble-product-overlay-card__placeholder {
    display: block;
    height: 100%;
    object-fit: cover;
    scale: 1;
    transition:
      transform 1.3s cubic-bezier(0.16, 1, 0.3, 1),
      scale 1.3s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.3s ease-in-out;
    width: 100%;
  }

  .pebble-product-overlay-card__placeholder {
    background: transparent;
    color: rgba(17, 17, 17, 0.28);
    padding: 18%;
  }

  .pebble-product-overlay-card__badge {
    align-items: center;
    backdrop-filter: blur(50px);
    background:
      linear-gradient(
        111.49deg,
        rgba(255, 255, 255, 0.4) -8.95%,
        rgba(255, 255, 255, 0.01) 114%
      );
    border-radius: 0.625rem;
    bottom: 10px;
    color: var(--card-text, #ffffff);
    display: flex;
    gap: 0.75rem;
    left: 12px;
    min-height: 72px;
    padding: 10px;
    position: absolute;
    right: 12px;
    -webkit-backdrop-filter: blur(50px);
    z-index: 1;
  }

  .pebble-product-overlay-card__badge::before {
    background: linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.5),
      rgba(255, 255, 255, 0.1),
      rgba(255, 255, 255, 0.5)
    );
    border-radius: inherit;
    content: '';
    inset: 0;
    mask:
      linear-gradient(#000 0 0) exclude,
      linear-gradient(#000 0 0) content-box;
    padding: 1px;
    pointer-events: none;
    position: absolute;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    z-index: -1;
  }

  .pebble-product-overlay-card__product-image {
    aspect-ratio: var(--product-ratio, 1 / 1);
    background: #ffffff;
    border-radius: 0.625rem;
    flex: 0 0 50px;
    overflow: hidden;
  }

  .pebble-product-overlay-card__product-image img,
  .pebble-product-overlay-card__product-placeholder {
    display: block;
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  .pebble-product-overlay-card__product-placeholder {
    color: rgba(17, 17, 17, 0.32);
    padding: 0.65rem;
  }

  .pebble-product-overlay-card__details {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
  }

  .pebble-product-overlay-card__title,
  .pebble-product-overlay-card__price {
    color: inherit;
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.5rem;
  }

  .pebble-product-overlay-card__title {
    overflow: hidden;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pebble-product-overlay-card__title-text {
    background:
      linear-gradient(currentColor, currentColor)
      no-repeat 100% 100% / 0 1px;
    transition: background-size 350ms cubic-bezier(0.3, 1, 0.3, 1);
  }

  .pebble-product-overlay-card__shop {
    align-items: center;
    background: var(--card-button, #ffffff);
    border-radius: 3.75rem;
    color: var(--card-button-label, #111111);
    display: none;
    flex: 0 0 auto;
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    isolation: isolate;
    justify-content: center;
    line-height: 1.5rem;
    min-height: 2.75rem;
    overflow: hidden;
    padding-inline: 1.25rem;
    position: relative;
    text-decoration: none;
    transition: color 300ms ease-in-out;
    z-index: 0;
  }

  .pebble-product-overlay-card__shop::before {
    background: var(--card-button-label, #111111);
    border-radius: inherit;
    bottom: -1px;
    content: '';
    left: -1px;
    position: absolute;
    top: -1px;
    transition: width 300ms ease-in-out;
    width: 0;
    z-index: -1;
  }

  @container (min-width: 301px) {
    .pebble-product-overlay-card__shop {
      display: inline-flex;
    }
  }

  @container (min-width: 341px) {
    .pebble-product-overlay-card__badge {
      bottom: 20px;
      left: 20px;
      right: 20px;
    }

    .pebble-product-overlay-card__product-image {
      flex-basis: 60px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .pebble-product-overlay-card:hover .pebble-product-overlay-card__banner,
    .pebble-product-overlay-card:focus-within .pebble-product-overlay-card__banner {
      scale: 1.05;
    }

    .pebble-product-overlay-card__shop:hover,
    .pebble-product-overlay-card__shop:focus-visible {
      color: var(--card-button, #ffffff);
    }

    .pebble-product-overlay-card__shop:hover::before,
    .pebble-product-overlay-card__shop:focus-visible::before {
      width: calc(100% + 2px);
    }

    .pebble-product-overlay-card__title:hover .pebble-product-overlay-card__title-text,
    .pebble-product-overlay-card__title:focus-visible .pebble-product-overlay-card__title-text {
      background-position: 0 100%;
      background-size: 100% 1px;
    }

    .pebble-scrolling-cards .pebble-button:hover .pebble-button__hover,
    .pebble-scrolling-cards .pebble-button:focus-visible .pebble-button__hover {
      clip-path: circle(150% at calc(100% - var(--pebble-icon-radius) - var(--pebble-button-end-padding)) 50%);
    }
  }

  @media screen and (min-width: 768px) {
    .pebble-scrolling-cards__content-inner > .pebble-subheading {
      font-size: 0.9375rem;
      line-height: 1.5rem;
      margin-bottom: 0;
      padding-bottom: 1.25rem;
    }

    .pebble-scrolling-cards__content-inner > .pebble-text {
      margin-top: 1.5rem;
      max-width: min(var(--text-max-width, 42ch), 19.5rem);
    }
  }

  @media screen and (min-width: 768px) and (max-width: 1199.98px) {
    .pebble-scrolling-cards__page {
      width: calc(100% - 2rem);
    }

    .pebble-scrolling-cards__cards,
    .pebble-scrolling-cards__content {
      column-gap: 50px;
    }

    .pebble-scrolling-cards__card-cell:nth-child(even) {
      padding-top: 140px;
    }
  }

  @media screen and (min-width: 1440px) {
    .pebble-scrolling-cards__page {
      width: min(calc(100% - 16.875rem), 90rem);
    }
  }

  @media screen and (max-width: 767.98px) {
    .pebble-scrolling-cards {
      padding-block:
        min(var(--scroll-padding-top, 48px), 48px)
        min(var(--scroll-padding-bottom, 48px), 48px);
    }

    .pebble-scrolling-cards__page {
      display: grid;
      gap: 0;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
    }

    .pebble-scrolling-cards__content-shell,
    .pebble-scrolling-cards__content,
    .pebble-scrolling-cards__content-inner {
      display: contents;
    }

    .pebble-scrolling-cards__content-shell {
      pointer-events: auto;
    }

    .pebble-scrolling-cards__cards {
      display: flex;
      gap: 8px;
      margin-top: 1.5rem;
      min-height: 0;
      order: 4;
      overflow-x: auto;
      padding-inline: 1rem;
      row-gap: 0;
      scroll-padding-inline: 1rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .pebble-scrolling-cards__cards::-webkit-scrollbar {
      display: none;
    }

    .pebble-scrolling-cards__card-cell {
      flex: 0 0 var(--scroll-mobile-card-width, 73vw);
      grid-column: auto;
      padding-top: 0 !important;
      scroll-snap-align: start;
    }

    .pebble-scrolling-cards__card-cell > .pebble-product-overlay-card {
      aspect-ratio: var(--card-ratio-mobile, 3 / 4);
    }

    .pebble-scrolling-cards__content-inner > .pebble-subheading {
      justify-self: center;
      margin-bottom: 1.3125rem;
      width: calc(100% - 2rem);
    }

    .pebble-scrolling-cards__heading-viewport {
      justify-self: center;
      overflow: clip;
      width: calc(100% - 2rem);
    }

    .pebble-scrolling-heading {
      min-height: 0 !important;
    }

    .pebble-scrolling-cards__content-inner > .pebble-text {
      justify-self: center;
      margin-top: 1.25rem;
      max-width: min(var(--text-max-width, 42ch), calc(100% - 2rem));
      width: calc(100% - 2rem);
    }

    .pebble-scrolling-cards .pebble-button {
      justify-self: stretch;
      margin: 1.5rem 1rem 0;
      max-width: none;
      order: 5;
      width: auto;
    }

    .pebble-product-overlay-card__title,
    .pebble-product-overlay-card__price,
    .pebble-product-overlay-card__shop {
      font-size: 0.875rem;
      line-height: 1.25rem;
    }

    .pebble-product-overlay-card__shop {
      min-height: 2.5rem;
      padding-inline: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pebble-scrolling-cards__heading-track,
    .pebble-product-overlay-card__banner,
    .pebble-product-overlay-card__shop,
    .pebble-scrolling-cards .pebble-button__hover {
      transition-duration: 0.01ms !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const sectionSelector = '[data-pebble-scrolling-cards]';
    const desktopQuery = window.matchMedia('(min-width: 768px)');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const clamp = (value, minimum, maximum) => Math.min(Math.max(value, minimum), maximum);
    const smoothingClass = 'pebble-scrolling-cards-smoothing';

    const initializeSection = (section) => {
      if (!section || section.dataset.scrollingCardsInitialized === 'true') return;

      const track = section.querySelector('[data-scrolling-track]');
      const stickyContent = section.querySelector('[data-scrolling-content]');
      const headingViewport = section.querySelector('[data-heading-viewport]');
      const headingTrack = section.querySelector('[data-heading-track]');
      const headings = Array.from(section.querySelectorAll('[data-scrolling-heading]'));

      if (!track || !stickyContent || !headingViewport || !headingTrack || headings.length === 0) return;

      section.dataset.scrollingCardsInitialized = 'true';
      const controller = new AbortController();
      const signal = controller.signal;
      let animationFrame = 0;
      let activeIndex = -1;
      let metrics = null;
      let mobileMetrics = null;
      let resizeObserver = null;
      let targetScroll = window.scrollY;
      let isSmoothing = false;

      const setActiveHeading = (index) => {
        if (activeIndex === index) return;
        activeIndex = index;

        headings.forEach((heading, headingIndex) => {
          heading.setAttribute('aria-hidden', String(headingIndex !== index));
          heading.classList.toggle('is-active', headingIndex === index);
        });
      };

      const stopSmoothing = () => {
        isSmoothing = false;
        targetScroll = window.scrollY;
        document.documentElement.classList.remove(smoothingClass);
      };

      const prepareHeadings = () => {
        headingTrack.style.removeProperty('--heading-offset');
        headingViewport.style.removeProperty('height');
        headings.forEach((heading) => heading.style.removeProperty('height'));

        const headingHeight = Math.max(
          ...headings.map((heading) => Math.ceil(heading.getBoundingClientRect().height))
        );

        headings.forEach((heading) => {
          heading.style.height = `${headingHeight}px`;
        });
        headingViewport.style.height = `${headingHeight}px`;

        return {
          headingHeight,
          headingTravel: Math.max(headingTrack.scrollHeight - headingHeight, 0)
        };
      };

      const updateMobileHeading = () => {
        if (desktopQuery.matches || !mobileMetrics) return;

        const scrollTravel = Math.max(track.scrollWidth - track.clientWidth, 0);
        const progress = scrollTravel > 0
          ? clamp(Math.abs(track.scrollLeft) / scrollTravel, 0, 1)
          : 0;
        const position = progress * (headings.length - 1);
        const headingIndex = Math.round(position);
        const visualProgress = reducedMotionQuery.matches
          ? headingIndex / Math.max(headings.length - 1, 1)
          : progress;
        const headingOffset = -(mobileMetrics.headingTravel * visualProgress);

        headingTrack.style.setProperty('--heading-offset', `${headingOffset}px`);
        section.style.setProperty('--scroll-progress', String(progress));
        section.classList.remove('is-pinned');
        setActiveHeading(headingIndex);
      };

      const measureMobile = () => {
        stopSmoothing();
        const headingMetrics = prepareHeadings();

        mobileMetrics = {
          headingTravel: headingMetrics.headingTravel
        };
        metrics = null;
        updateMobileHeading();
      };

      const updateHeading = (scrollTop) => {
        if (!desktopQuery.matches || !metrics) return;

        const progress = clamp((scrollTop - metrics.start) / metrics.travel, 0, 1);
        const position = progress * (headings.length - 1);
        const headingIndex = Math.round(position);
        const visualProgress = reducedMotionQuery.matches
          ? headingIndex / Math.max(headings.length - 1, 1)
          : progress;
        const headingOffset = -(metrics.headingTravel * visualProgress);

        headingTrack.style.setProperty('--heading-offset', `${headingOffset}px`);
        section.style.setProperty('--scroll-progress', String(progress));
        section.classList.toggle(
          'is-pinned',
          scrollTop >= metrics.start && scrollTop <= metrics.end
        );
        setActiveHeading(headingIndex);
      };

      const render = () => {
        animationFrame = 0;

        if (!desktopQuery.matches) {
          updateMobileHeading();
          return;
        }

        if (!metrics) {
          return;
        }

        if (isSmoothing) {
          const distance = targetScroll - window.scrollY;

          if (Math.abs(distance) <= 1) {
            window.scrollTo(0, targetScroll);
            stopSmoothing();
          } else {
            const easedStep = Math.sign(distance) * Math.max(Math.abs(distance) * 0.16, 1);
            const nextStep = Math.abs(easedStep) > Math.abs(distance) ? distance : easedStep;
            window.scrollTo(0, window.scrollY + nextStep);
          }
        }

        updateHeading(window.scrollY);

        if (isSmoothing) {
          animationFrame = window.requestAnimationFrame(render);
        }
      };

      const scheduleRender = () => {
        if (animationFrame) return;
        animationFrame = window.requestAnimationFrame(render);
      };

      const measure = () => {
        if (!desktopQuery.matches) {
          measureMobile();
          return;
        }

        mobileMetrics = null;
        const headingMetrics = prepareHeadings();
        const headingHeight = headingMetrics.headingHeight;

        const header = document.querySelector('[data-site-header] .site-header__inner');
        const headerHeight = header
          ? Math.round(header.getBoundingClientRect().height)
          : 80;
        const trackRect = track.getBoundingClientRect();
        const travel = Math.max(track.offsetHeight - window.innerHeight, 1);

        section.style.setProperty('--scroll-header-height', `${headerHeight}px`);

        metrics = {
          start: trackRect.top + window.scrollY,
          travel,
          end: trackRect.top + window.scrollY + travel,
          headingTravel: headingMetrics.headingTravel
        };

        targetScroll = clamp(window.scrollY, metrics.start, metrics.end);
        scheduleRender();
      };

      const normalizeWheelDelta = (event) => {
        if (event.deltaMode === 1) return event.deltaY * 16;
        if (event.deltaMode === 2) return event.deltaY * window.innerHeight;
        return event.deltaY;
      };

      const handleWheel = (event) => {
        if (
          !desktopQuery.matches ||
          reducedMotionQuery.matches ||
          !metrics ||
          event.ctrlKey
        ) {
          return;
        }

        const delta = normalizeWheelDelta(event);
        if (Math.abs(delta) < 0.01) return;

        const scrollTop = window.scrollY;
        const movingDown = delta > 0;
        const movingUp = delta < 0;
        const currentTarget = isSmoothing ? targetScroll : scrollTop;
        const projectedTarget = currentTarget + delta;
        const insideRange = scrollTop >= metrics.start - 1 && scrollTop <= metrics.end + 1;
        const enteringFromTop = movingDown && scrollTop < metrics.start && projectedTarget >= metrics.start;
        const enteringFromBottom = movingUp && scrollTop > metrics.end && projectedTarget <= metrics.end;
        const releasingAtBottom =
          movingDown &&
          scrollTop >= metrics.end - 1 &&
          (!isSmoothing || targetScroll >= metrics.end - 0.5);
        const releasingAtTop =
          movingUp &&
          scrollTop <= metrics.start + 1 &&
          (!isSmoothing || targetScroll <= metrics.start + 0.5);

        if (releasingAtBottom || releasingAtTop) {
          stopSmoothing();
          return;
        }

        if (!insideRange && !enteringFromTop && !enteringFromBottom) return;

        event.preventDefault();
        targetScroll = clamp(projectedTarget, metrics.start, metrics.end);
        isSmoothing = true;
        document.documentElement.classList.add(smoothingClass);
        scheduleRender();
      };

      window.addEventListener('wheel', handleWheel, { passive: false, signal });
      window.addEventListener('scroll', () => {
        if (!isSmoothing) targetScroll = window.scrollY;
        scheduleRender();
      }, { passive: true, signal });
      track.addEventListener('scroll', () => {
        if (!desktopQuery.matches) scheduleRender();
      }, { passive: true, signal });
      window.addEventListener('resize', measure, { passive: true, signal });
      desktopQuery.addEventListener('change', measure, { signal });
      reducedMotionQuery.addEventListener('change', () => {
        stopSmoothing();
        scheduleRender();
      }, { signal });

      if ('ResizeObserver' in window) {
        resizeObserver = new ResizeObserver(measure);
        resizeObserver.observe(track);
      }

      document.addEventListener('shopify:block:select', (event) => {
        if (!(event.target instanceof Element) || !section.contains(event.target)) return;

        measure();

        const selectedHeading = event.target.closest('[data-scrolling-heading]');
        const selectedCard = event.target.closest('[data-scrolling-card]');
        let selectedIndex = -1;
        let itemCount = 1;

        if (selectedHeading) {
          selectedIndex = headings.indexOf(selectedHeading);
          itemCount = headings.length;
        } else if (selectedCard) {
          const cards = Array.from(section.querySelectorAll('[data-scrolling-card]'));
          selectedIndex = Math.floor(cards.indexOf(selectedCard) / 2);
          itemCount = Math.ceil(cards.length / 2);
        }

        if (selectedIndex < 0 || !metrics || !desktopQuery.matches) return;

        const selectedProgress = selectedIndex / Math.max(itemCount - 1, 1);
        window.scrollTo(0, metrics.start + metrics.travel * selectedProgress);
        scheduleRender();
      }, { signal });

      document.addEventListener('shopify:section:unload', (event) => {
        if (event.target instanceof Element && event.target.contains(section)) {
          resizeObserver?.disconnect();
          if (animationFrame) window.cancelAnimationFrame(animationFrame);
          stopSmoothing();
          controller.abort();
          section.dataset.scrollingCardsInitialized = 'false';
        }
      }, { signal });

      measure();
      document.fonts?.ready.then(measure);
    };

    const initializeWithin = (root) => {
      if (root instanceof Element && root.matches(sectionSelector)) {
        initializeSection(root);
      }
      root.querySelectorAll?.(sectionSelector).forEach(initializeSection);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initializeWithin(document), { once: true });
    } else {
      initializeWithin(document);
    }

    document.addEventListener('shopify:section:load', (event) => initializeWithin(event.target));
  })();
