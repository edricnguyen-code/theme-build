{% liquid
  assign menu_links = section.settings.menu.links
  if menu_links == blank
    assign menu_links = linklists.main-menu.links
  endif
%}

<header class="site-header{% if section.settings.enable_sticky_header %} site-header--sticky{% endif %}" data-site-header="{{ section.id }}">
  <div class="site-header__inner">
    <button
      class="site-header__icon-button site-header__menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="SiteHeaderMenu-{{ section.id }}"
      data-header-menu-toggle
    >
      <span class="visually-hidden">{{ 'general.header.open_menu' | t }}</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/>
      </svg>
    </button>

    <nav id="SiteHeaderMenu-{{ section.id }}" class="site-header__navigation" aria-label="{{ 'general.header.primary_navigation' | t }}" data-header-menu>
      <ul class="site-header__menu-list" role="list">
        {% if menu_links != blank %}
          {% for link in menu_links %}
            <li class="site-header__menu-item">
              {% if link.links != blank %}
                <details class="site-header__menu-dropdown">
                  <summary class="site-header__menu-link">
                    <span>{{ link.title | escape }}</span>
                    <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
                      <path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  <ul class="site-header__submenu" role="list">
                    {% for child_link in link.links %}
                      <li>
                        <a class="site-header__submenu-link" href="{{ child_link.url }}">{{ child_link.title | escape }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                </details>
              {% else %}
                <a class="site-header__menu-link" href="{{ link.url }}">{{ link.title | escape }}</a>
              {% endif %}
            </li>
          {% endfor %}
        {% else %}
          <li class="site-header__menu-item"><a class="site-header__menu-link" href="{{ routes.all_products_collection_url }}">{{ 'general.header.shop' | t }}</a></li>
          <li class="site-header__menu-item"><a class="site-header__menu-link" href="{{ routes.collections_url }}">{{ 'general.header.collections' | t }}</a></li>
          <li class="site-header__menu-item"><a class="site-header__menu-link" href="{{ routes.root_url }}">{{ 'general.header.pages' | t }}</a></li>
          <li class="site-header__menu-item"><a class="site-header__menu-link" href="{{ routes.root_url }}">{{ 'general.header.features' | t }}</a></li>
        {% endif %}
      </ul>
    </nav>

    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        <img
          class="site-header__logo-image"
          src="{{ section.settings.logo | image_url: width: 320 }}"
          alt="{{ shop.name | escape }}"
          width="160"
          height="32"
          loading="eager"
        >
      {% else %}
        <span class="site-header__logo-script">little</span><span class="site-header__logo-name">{{ shop.name | escape }}</span>
      {% endif %}
    </a>

    <div class="site-header__actions">
      <form class="site-header__search-form" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">{{ 'general.header.search' | t }}</label>
        <input id="HeaderSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.header.search_placeholder' | t }}">
        <button class="site-header__search-submit" type="submit" aria-label="{{ 'general.header.search' | t }}">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <circle cx="10.8" cy="10.8" r="6.2"/>
            <path d="m16 16 4.3 4.3" stroke-linecap="round"/>
          </svg>
        </button>
      </form>

      <a class="site-header__icon-button site-header__mobile-search" href="{{ routes.search_url }}" aria-label="{{ 'general.header.open_search' | t }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <circle cx="10.8" cy="10.8" r="6.2"/>
          <path d="m16 16 4.3 4.3" stroke-linecap="round"/>
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <a class="site-header__icon-button site-header__account" href="{{ routes.account_url }}" aria-label="{{ 'general.header.account' | t }}">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <circle cx="12" cy="8" r="3.3"/>
            <path d="M5.5 20c.7-3.3 3.1-5 6.5-5s5.8 1.7 6.5 5" stroke-linecap="round"/>
          </svg>
        </a>
      {% endif %}

      <a class="site-header__icon-button site-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'general.header.cart' | t: count: cart.item_count }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M4 5h2l1.4 10.2h9.8L20 8H7" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9.5" cy="19" r="1"/>
          <circle cx="17" cy="19" r="1"/>
        </svg>
        {% if cart.item_count > 0 %}<span class="site-header__cart-count">{{ cart.item_count }}</span>{% endif %}
      </a>
    </div>
  </div>
</header>


{% stylesheet %}
  .site-header {
    --header-border: rgba(17, 17, 17, 0.12);
    background: transparent;
    border: 0;
    color: #111111;
    padding: 0;
    position: relative;
    z-index: 20;
  }

  .site-header-wrapper--sticky {
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .site-header--sticky {
    position: relative;
  }

  .site-header--sticky .site-header__inner {
    transition:
      border-radius 420ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 180ms ease,
      border-color 180ms ease,
      padding 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header--sticky.is-scrolled .site-header__inner {
    border-color: rgba(17, 17, 17, 0.18);
    box-shadow: 0 0.6rem 1.75rem rgba(17, 17, 17, 0.14);
    border-radius: 0;
    width: 100%;
  }


  body.site-header-menu-open {
    overflow: hidden;
  }

  .site-header .visually-hidden {
    border: 0;
    clip: rect(0 0 0 0);
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .site-header__inner {
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--header-border);
    border-radius: 0.625rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    margin-inline: auto;
    min-height: 5rem;
    padding-inline: clamp(1rem, 2.5vw, 1.875rem);
    width: min(calc(100% - 2rem), 90rem);
  }

  .site-header__navigation {
    grid-column: 1;
    min-width: 0;
  }

  .site-header__menu-list,
  .site-header__submenu {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__menu-list {
    align-items: center;
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .site-header__menu-item,
  .site-header__menu-dropdown {
    position: relative;
  }

  .site-header__menu-link {
    align-items: center;
    color: inherit;
    display: inline-flex;
    font-size: 0.9375rem;
    font-weight: 500;
    gap: 0.3rem;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
  }

  summary.site-header__menu-link {
    cursor: pointer;
    list-style: none;
  }

  summary.site-header__menu-link::-webkit-details-marker {
    display: none;
  }

  .site-header__menu-link svg {
    height: 0.8rem;
    width: 0.8rem;
  }

  .site-header__submenu {
    background: #ffffff;
    border: 1px solid var(--header-border);
    border-radius: 0.5rem;
    box-shadow: 0 0.75rem 2rem rgba(17, 17, 17, 0.12);
    left: -0.75rem;
    min-width: 12rem;
    padding: 0.55rem 0;
    position: absolute;
    top: calc(100% + 0.75rem);
    z-index: 30;
  }

  .site-header__submenu-link {
    color: inherit;
    display: block;
    font-size: 0.9375rem;
    padding: 0.55rem 1rem;
    text-decoration: none;
  }

  .site-header__submenu-link:hover,
  .site-header__submenu-link:focus-visible {
    background: rgba(17, 17, 17, 0.06);
  }

  .site-header__logo {
    align-items: center;
    color: inherit;
    display: inline-flex;
    grid-column: 2;
    justify-content: center;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__logo-image {
    display: block;
    height: auto;
    max-width: 10rem;
    width: 10rem;
  }

  .site-header__logo-script {
    font-family: "Brush Script MT", "Segoe Script", cursive;
    font-size: clamp(1.1rem, 1.7vw, 1.55rem);
    font-style: italic;
    font-weight: 600;
    margin-right: 0.16rem;
  }

  .site-header__logo-name {
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-size: clamp(1.1rem, 1.7vw, 1.55rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .site-header__actions {
    align-items: center;
    display: flex;
    gap: clamp(0.2rem, 0.8vw, 0.7rem);
    grid-column: 3;
    justify-content: flex-end;
    min-width: 0;
  }

  .site-header__search-form {
    align-items: center;
    display: flex;
    margin-right: clamp(0.25rem, 1.5vw, 1.25rem);
    max-width: 18rem;
    min-width: 0;
    width: min(100%, 18rem);
  }

  .site-header__search-form input {
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    min-width: 0;
    outline: 0;
    padding: 0.5rem 0.25rem;
    width: 100%;
  }

  .site-header__search-form input::placeholder {
    color: rgba(17, 17, 17, 0.62);
    opacity: 1;
  }

  .site-header__search-submit,
  .site-header__icon-button {
    align-items: center;
    background: transparent;
    border: 0;
    color: inherit;
    display: inline-flex;
    flex: 0 0 auto;
    justify-content: center;
    padding: 0;
    text-decoration: none;
  }

  .site-header__search-submit {
    cursor: pointer;
    height: 2.25rem;
    width: 2.25rem;
  }

  .site-header__icon-button {
    height: 2.25rem;
    position: relative;
    width: 2.25rem;
  }

  .site-header__search-submit svg,
  .site-header__icon-button svg {
    height: 1.3rem;
    width: 1.3rem;
  }

  .site-header__cart-count {
    align-items: center;
    background: #111111;
    border-radius: 50%;
    color: #ffffff;
    display: flex;
    font-size: 0.625rem;
    height: 1rem;
    justify-content: center;
    position: absolute;
    right: -0.05rem;
    top: -0.05rem;
    width: 1rem;
  }

  .site-header__menu-toggle,
  .site-header__mobile-search {
    display: none;
  }

  @media screen and (min-width: 1200px) {
    .site-header.site-header--sticky.site-header--overlay.is-scrolled {
      background: transparent;
      left: 0;
      padding: 0;
      position: fixed;
      right: 0;
      top: 0;
      transform: none;
      width: 100%;
    }

    .site-header.site-header--sticky.site-header--overlay.is-scrolled .site-header__inner {
      margin-inline: auto;
      min-height: 5rem;
      padding-inline: max(2.875rem, calc(50vw - 43.125rem)) !important;
      width: 100%;
    }
  }

  @media screen and (max-width: 767.98px) {
    .site-header.site-header--sticky.site-header--overlay.is-scrolled {
      padding: 0;
    }

    .site-header.site-header--sticky.site-header--overlay.is-scrolled .site-header__inner {
      border-radius: 0;
      width: 100%;
    }

    .site-header__inner {
      border-radius: 0;
      border-inline: 0;
      grid-template-columns: 3.75rem minmax(0, 1fr) 3.75rem 3.75rem;
      min-height: 3.75rem;
      padding: 0;
      width: 100%;
    }

    .site-header__menu-toggle,
    .site-header__mobile-search {
      display: inline-flex;
    }

    .site-header__menu-toggle {
      grid-column: 1;
    }

    .site-header__logo {
      grid-column: 2;
      min-width: 0;
    }

    .site-header__logo-image {
      max-width: 7.8125rem;
      width: 7.8125rem;
    }

    .site-header__logo-script,
    .site-header__logo-name {
      font-size: 1.225rem;
    }

    .site-header__navigation {
      background: #ffffff;
      border-top: 1px solid var(--header-border);
      bottom: 0;
      display: none;
      left: 0;
      overflow-y: auto;
      position: fixed;
      right: 0;
      top: 3.75rem;
      z-index: 25;
    }

    .site-header__navigation.is-open {
      display: block;
    }

    .site-header__menu-list {
      align-items: stretch;
      display: block;
      padding: 0.5rem 1rem 2rem;
    }

    .site-header__menu-item {
      border-bottom: 1px solid var(--header-border);
    }

    .site-header__menu-link {
      display: flex;
      font-size: 1rem;
      justify-content: space-between;
      padding: 1rem 0;
      width: 100%;
    }

    .site-header__submenu {
      background: transparent;
      border: 0;
      box-shadow: none;
      min-width: 0;
      padding: 0 0 0.5rem 1rem;
      position: static;
    }

    .site-header__submenu-link {
      padding: 0.6rem 0;
    }

    .site-header__search-form,
    .site-header__account {
      display: none;
    }

    .site-header__actions {
      display: contents;
    }

    .site-header__mobile-search {
      grid-column: 3;
    }

    .site-header__cart {
      grid-column: 4;
    }

    .site-header__icon-button {
      height: 3.75rem;
      width: 3.75rem;
    }
  }

  @media screen and (min-width: 768px) and (max-width: 1199.98px) {
    body.site-header-menu-open {
      overflow: auto;
    }

    .site-header__inner {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      min-height: clamp(4.5rem, 8vw, 5rem);
      padding: clamp(0.625rem, 1.5vw, 0.875rem) clamp(1rem, 3vw, 2rem);
    }

    .site-header__menu-toggle {
      display: none;
    }

    .site-header__logo-image {
      max-width: clamp(7rem, 15vw, 9rem);
    }

    .site-header__logo-script,
    .site-header__logo-name {
      font-size: clamp(1.05rem, 2vw, 1.4rem);
    }

    .site-header__navigation {
      background: transparent;
      border: 0;
      display: block;
      overflow: visible;
      position: static;
    }

    .site-header__navigation.is-open {
      display: block;
    }

    .site-header__menu-list {
      align-items: center;
      column-gap: clamp(0.75rem, 1.7vw, 1.25rem);
      display: flex;
      flex-wrap: wrap;
      row-gap: 0.35rem;
    }

    .site-header__menu-item {
      border: 0;
    }

    .site-header__menu-link {
      font-size: clamp(0.75rem, 1.35vw, 0.9rem);
      justify-content: flex-start;
      padding: 0.3rem 0;
      white-space: nowrap;
      width: auto;
    }

    .site-header__submenu {
      background: #ffffff;
      border: 1px solid var(--header-border);
      box-shadow: 0 0.75rem 2rem rgba(17, 17, 17, 0.12);
      min-width: 11rem;
      padding: 0.55rem 0;
      position: absolute;
    }

    .site-header__submenu-link {
      padding: 0.65rem 0.85rem;
    }

    .site-header__search-form {
      display: none;
    }

    .site-header__actions {
      display: flex;
    }

    .site-header__mobile-search {
      display: inline-flex;
    }

    .site-header__icon-button {
      height: clamp(2.75rem, 5vw, 3.25rem);
      width: clamp(2.75rem, 5vw, 3.25rem);
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const initializeHeader = (header) => {
      if (!header || header.dataset.initialized === 'true') return;

      const toggle = header.querySelector('[data-header-menu-toggle]');
      const menu = header.querySelector('[data-header-menu]');
      if (!toggle || !menu) return;

      header.dataset.initialized = 'true';
      const controller = new AbortController();
      const signal = controller.signal;
      let stickyThreshold = 8;
      let overlayStickyThreshold = null;

      const setMenuState = (isOpen) => {
        menu.classList.toggle('is-open', isOpen);
        toggle.setAttribute('aria-expanded', String(isOpen));
        document.body.classList.toggle('site-header-menu-open', isOpen);
      };

      const updateScrollState = () => {
        if (!header.classList.contains('site-header--sticky')) return;
        header.classList.toggle('is-scrolled', window.scrollY >= stickyThreshold);
      };

      const detectOverlayHeader = () => {
        const firstSection = document.querySelector('#MainContent > .shopify-section');
        const overlayHero = firstSection?.querySelector('.pebble-slider--header-overlay');
        const wrapper = header.closest('.shopify-section');
        const desktopOverlay = Boolean(overlayHero) && window.matchMedia('(min-width: 1200px)').matches;

        if (desktopOverlay) {
          if (!header.classList.contains('is-scrolled')) {
            overlayStickyThreshold = Math.max(0, header.getBoundingClientRect().top + window.scrollY);
          }
          stickyThreshold = overlayStickyThreshold ?? 8;
        } else {
          stickyThreshold = 8;
        }

        header.classList.toggle('site-header--overlay', Boolean(overlayHero));
        wrapper?.classList.toggle(
          'site-header-wrapper--sticky',
          header.classList.contains('site-header--sticky') && !desktopOverlay
        );
        updateScrollState();
      };

      header.pebbleRefreshLayout = detectOverlayHeader;

      toggle.addEventListener('click', () => {
        setMenuState(toggle.getAttribute('aria-expanded') !== 'true');
      }, { signal });

      menu.addEventListener('click', (event) => {
        if (event.target.closest('a')) setMenuState(false);
      }, { signal });

      document.addEventListener('click', (event) => {
        if (!header.contains(event.target)) setMenuState(false);
      }, { signal });

      window.addEventListener('scroll', updateScrollState, { passive: true, signal });

      window.addEventListener('resize', () => {
        if (window.matchMedia('(min-width: 1200px)').matches) setMenuState(false);
        detectOverlayHeader();
      }, { signal });

      document.addEventListener('shopify:section:unload', (event) => {
        if (event.target instanceof Element && event.target.contains(header)) {
          setMenuState(false);
          delete header.pebbleRefreshLayout;
          controller.abort();
        }
      }, { signal });

      detectOverlayHeader();
    };

    const initializeWithin = (root) => {
      if (root instanceof Element && root.matches('[data-site-header]')) {
        initializeHeader(root);
      }
      root.querySelectorAll?.('[data-site-header]').forEach(initializeHeader);
    };

    const initializeAll = () => initializeWithin(document);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeAll, { once: true });
    } else {
      initializeAll();
    }

    const refreshAllHeaders = () => {
      document.querySelectorAll('[data-site-header]').forEach((header) => {
        header.pebbleRefreshLayout?.();
      });
    };

    document.addEventListener('shopify:section:load', (event) => {
      initializeWithin(event.target);
      refreshAllHeaders();
    });

    window.addEventListener('load', refreshAllHeaders);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
