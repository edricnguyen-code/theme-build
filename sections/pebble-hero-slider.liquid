  ],
  "presets": [
    {
      "name": "Pebble hero slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "New campaign",
            "heading": "Softness\nin Comfort",
            "button_label": "Shop collection"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Little moments",
            "heading": "Wrapped\nin Warmth",
            "button_label": "Shop collection"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Made for play",
            "heading": "Every layer\ntells a story",
            "button_label": "Discover more"
          }
        }
      ]
    }
  ]
}
{% endschema %}
