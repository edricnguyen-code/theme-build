{% liquid
  assign slide_scheme = block.settings.color_scheme
  assign video = block.settings.video
%}

<article
  class="pebble-slider__slide swiper-slide color-{{ slide_scheme.id }}"
  aria-roledescription="slide"
  data-slide-block
  style="
    --slide-background: {{ slide_scheme.settings.background }};
    --slide-text: {{ slide_scheme.settings.text }};
    --slide-button: {{ slide_scheme.settings.button }};
    --slide-button-label: {{ slide_scheme.settings.button_label }};
    --slide-overlay-color: {{ block.settings.overlay_color }};
  "
  {{ block.shopify_attributes }}
>
  <div class="pebble-slider__media">
    {% if video != blank %}
      {{
        video
        | video_tag:
          class: 'pebble-slider__video',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          image_size: '2400x'
      }}
    {% elsif block.settings.poster != blank %}
      {{
        block.settings.poster
        | image_url: width: 3000
        | image_tag:
          class: 'pebble-slider__image pebble-slider__image--desktop',
          widths: '750, 1100, 1500, 2000, 2500, 3000',
          sizes: '100vw',
          loading: 'eager'
      }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'pebble-slider__placeholder' }}
    {% endif %}
  </div>

  {% if block.settings.media_overlay %}
    <div class="pebble-slider__overlay"></div>
  {% endif %}

  <div class="pebble-slider__content-position pebble-slider__content-position--{{ block.settings.position }} pebble-slider__content-position--mobile-{{ block.settings.position_mobile }}">
    {% content_for 'blocks' %}
  </div>
</article>

{% schema %}
{
  "name": "Video slide",
  "tag": null,
  "blocks": [
    {
      "type": "slide-content"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image"
    },
    {
      "type": "checkbox",
      "id": "media_overlay",
      "label": "Media overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000",
      "visible_if": "{{ block.settings.media_overlay }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-left"
    },
    {
      "type": "select",
      "id": "position_mobile",
      "label": "Position mobile",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Video slide",
      "blocks": [
        {
          "type": "slide-content",
          "blocks": [
            {
              "type": "text",
              "settings": {
                "text": "<p>Watch the story</p>",
                "style": "eyebrow"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Made for<br>every moment</p>",
                "style": "display"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
