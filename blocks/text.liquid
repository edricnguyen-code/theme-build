{% liquid
  assign text_line_height = 1.2
  if block.settings.line_height == 'tight'
    assign text_line_height = 1
  elsif block.settings.line_height == 'normal'
    assign text_line_height = 1.1
  endif

  assign text_weight = block.settings.font_weight
  if text_weight == 'inherit'
    assign text_weight = 'var(--pebble-heading-weight, 700)'
  endif
%}

<div
  class="
    pebble-content-block
    pebble-text
    pebble-text--preset-{{ block.settings.preset }}
    pebble-text--font-{{ block.settings.font_family }}
    pebble-text--color-{{ block.settings.color }}
    pebble-text--highlight-{{ block.settings.highlight_style }}
    pebble-text--width-{{ block.settings.width }}
    pebble-text--mobile-width-{{ block.settings.width_mobile }}
    {% if block.settings.disable_line_break_mobile %}pebble-text--single-line-mobile{% endif %}
  "
  data-motion="{{ block.settings.animation }}"
  style="
    --text-size: {{ block.settings.font_size }}px;
    --text-size-mobile: {{ block.settings.font_size_mobile }}px;
    --text-weight: {{ text_weight }};
    --text-line-height: {{ text_line_height }};
    --text-max-width: {{ block.settings.max_width }}ch;
    --text-padding-top: {{ block.settings.padding_top }}px;
    --text-padding-bottom: {{ block.settings.padding_bottom }}px;
    --text-padding-left: {{ block.settings.padding_left }}px;
    --text-padding-right: {{ block.settings.padding_right }}px;
    --text-mobile-scale: {{ block.settings.mobile_scale | divided_by: 100.0 }};
    --motion-delay: {{ block.settings.animation_delay }}ms;
  "
  {{ block.shopify_attributes }}
>
  {{ block.settings.text }}
</div>

{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Text</p>"
    },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "Highlight style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" },
        { "value": "wavy-underline", "label": "Wavy underline" },
        { "value": "solid-background", "label": "Solid background" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "preset",
      "label": "Preset",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "paragraph", "label": "Paragraph" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading-1", "label": "Heading 1" },
        { "value": "heading-2", "label": "Heading 2" },
        { "value": "heading-3", "label": "Heading 3" },
        { "value": "heading-4", "label": "Heading 4" },
        { "value": "heading-5", "label": "Heading 5" },
        { "value": "heading-6", "label": "Heading 6" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "paragraph"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "heading", "label": "Heading" }
      ],
      "default": "heading",
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "inherit",
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 68,
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size mobile",
      "min": 10,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 38,
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "Line height",
      "options": [
        { "value": "tight", "label": "Tight" },
        { "value": "normal", "label": "Normal" },
        { "value": "loose", "label": "Loose" }
      ],
      "default": "loose",
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "color",
      "label": "Color",
      "options": [
        { "value": "text", "label": "Text" },
        { "value": "subtext", "label": "Subtext" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "text"
    },
    {
      "type": "checkbox",
      "id": "disable_line_break_mobile",
      "label": "Disable line break on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "fit"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width mobile",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "ch",
      "default": 30
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_scale",
      "label": "Mobile scale",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade-in", "label": "Fade in" },
        { "value": "fade-up", "label": "Fade up" },
        { "value": "slide-left", "label": "Slide in (left)" },
        { "value": "slide-right", "label": "Slide in (right)" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "Delay",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.animation != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "Text",
      "settings": {
        "preset": "paragraph"
      }
    }
  ]
}
{% endschema %}
