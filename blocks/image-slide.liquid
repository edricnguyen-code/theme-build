{% liquid
  assign slide_scheme = block.settings.color_scheme
  assign desktop_image = block.settings.image
  assign mobile_image = block.settings.image_mobile
  assign fallback_desktop = 'pebble-slide-1.webp'
  assign fallback_mobile = 'pebble-slide-1-mobile.webp'

  if block.settings.default_media == 'pebble-2'
    assign fallback_desktop = 'pebble-slide-2.webp'
    assign fallback_mobile = 'pebble-slide-2-mobile.webp'
  endif
%}

<article
  class="pebble-slider__slide swiper-slide color-{{ slide_scheme.id }}"
  aria-roledescription="slide"
  data-slide-block
  style="
    --slide-background: {{ slide_scheme.settings.background }};
    --slide-text: {{ slide_scheme.settings.text }};
    --slide-button: {{ slide_scheme.settings.button }};
    --slide-button-label: {{ slide_scheme.settings.button_label }};
    --slide-overlay-color: {{ block.settings.overlay_color }};
  "
  {{ block.shopify_attributes }}
>
  <div class="pebble-slider__media{% if mobile_image != blank or desktop_image == blank %} pebble-slider__media--has-mobile{% endif %}">
    {% if desktop_image != blank %}
      {{
        desktop_image
        | image_url: width: 3000
        | image_tag:
          class: 'pebble-slider__image pebble-slider__image--desktop',
          widths: '750, 1100, 1500, 2000, 2500, 3000',
          sizes: '100vw',
          loading: 'eager'
      }}
    {% else %}
      <img
        class="pebble-slider__image pebble-slider__image--desktop"
        src="{{ fallback_desktop | asset_url }}"
        width="1680"
        height="875"
        loading="eager"
        alt=""
      >
    {% endif %}

    {% if mobile_image != blank %}
      {{
        mobile_image
        | image_url: width: 1500
        | image_tag:
          class: 'pebble-slider__image pebble-slider__image--mobile',
          widths: '375, 550, 750, 1000, 1200, 1500',
          sizes: '100vw',
          loading: 'eager'
      }}
    {% elsif desktop_image == blank %}
      <img
        class="pebble-slider__image pebble-slider__image--mobile"
        src="{{ fallback_mobile | asset_url }}"
        width="480"
        height="743"
        loading="eager"
        alt=""
      >
    {% endif %}
  </div>

  {% if block.settings.media_overlay %}
    <div class="pebble-slider__overlay"></div>
  {% endif %}

  <div class="pebble-slider__content-position pebble-slider__content-position--{{ block.settings.position }} pebble-slider__content-position--mobile-{{ block.settings.position_mobile }}">
    {% content_for 'blocks' %}
  </div>
</article>

{% schema %}
{
  "name": "Image slide",
  "tag": null,
  "blocks": [
    {
      "type": "slide-content"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile"
    },
    {
      "type": "select",
      "id": "default_media",
      "label": "Demo placeholder",
      "info": "Used until custom desktop and mobile images are selected.",
      "options": [
        { "value": "pebble-1", "label": "Pebble pink" },
        { "value": "pebble-2", "label": "Pebble green" }
      ],
      "default": "pebble-1"
    },
    {
      "type": "checkbox",
      "id": "media_overlay",
      "label": "Media overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000",
      "visible_if": "{{ block.settings.media_overlay }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-left"
    },
    {
      "type": "select",
      "id": "position_mobile",
      "label": "Position mobile",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Image slide",
      "settings": {
        "default_media": "pebble-1",
        "media_overlay": true,
        "overlay_color": "#000000",
        "position": "middle-left",
        "position_mobile": "bottom",
        "color_scheme": "scheme-2"
      },
      "blocks": [
        {
          "type": "slide-content",
          "settings": {
            "alignment": "left",
            "alignment_mobile": "center",
            "row_gap": 0,
            "row_gap_mobile": 0,
            "width": "fit",
            "inherit_color_scheme": true,
            "transparent_background": true,
            "border": "none",
            "corner_radius": 0,
            "animation": "none"
          },
          "blocks": [
            {
              "type": "text",
              "settings": {
                "text": "<p>New Campaign</p>",
                "preset": "subheading",
                "padding_bottom": 16,
                "mobile_scale": 100,
                "animation": "fade-up",
                "animation_delay": 50
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Softness<br>in Comfort</p>",
                "preset": "custom",
                "font_family": "heading",
                "font_weight": "inherit",
                "font_size": 68,
                "font_size_mobile": 38,
                "line_height": "loose",
                "padding_bottom": 32,
                "mobile_scale": 75,
                "animation": "fade-up",
                "animation_delay": 150
              }
            },
            {
              "type": "button",
              "settings": {
                "label": "Shop Collection",
                "style": "primary",
                "size": "large",
                "icon": "caret-right",
                "icon_style": "solid",
                "full_width_mobile": true,
                "animation": "fade-up",
                "animation_delay": 250
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
