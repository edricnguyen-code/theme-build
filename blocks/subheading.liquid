{% liquid
  assign subheading_fluid_delta = block.settings.font_size | minus: block.settings.font_size_mobile
  assign subheading_fluid_slope = subheading_fluid_delta | times: 100.0 | divided_by: 512.0
  assign subheading_fluid_start_offset = subheading_fluid_slope | times: 7.68
  assign subheading_fluid_intercept = block.settings.font_size_mobile | minus: subheading_fluid_start_offset
%}

<div
  class="pebble-content-block pebble-subheading"
  data-motion="{{ block.settings.animation }}"
  style="
    --subheading-size: {{ block.settings.font_size }}px;
    --subheading-size-mobile: {{ block.settings.font_size_mobile }}px;
    --subheading-size-fluid: clamp({{ block.settings.font_size_mobile }}px, calc({{ subheading_fluid_intercept }}px + {{ subheading_fluid_slope }}vw), {{ block.settings.font_size }}px);
    --subheading-max-width: {{ block.settings.max_width }}ch;
    --motion-delay: {{ block.settings.animation_delay }}ms;
  "
  {{ block.shopify_attributes }}
>
  {{ block.settings.text }}
</div>

{% schema %}
{
  "name": "Subheading",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Subheading</p>"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size mobile",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "ch",
      "default": 36
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade-in", "label": "Fade in" },
        { "value": "fade-up", "label": "Fade up" },
        { "value": "slide-left", "label": "Slide in (left)" },
        { "value": "slide-right", "label": "Slide in (right)" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "Delay",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.animation != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "Subheading"
    }
  ]
}
{% endschema %}
